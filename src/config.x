/* keeperfx.cfg settings.
 *
 * KFXCFG(NAME, VALUES, CFG_DEFAULT, ABSENT_DEFAULT)
 *   VALUES:         '|'-separated options, or an inclusive range "MIN~MAX" (either bound optional).
 *                   "*N": array of exactly N space-separated entries; "*~N": up to N.
 *                   %WxHx32 any resolution, %STRING any string, %PATH a path.
 *   CFG_DEFAULT:    recommended value (should be shipped in stock keeperfx.cfg).
 *   ABSENT_DEFAULT: value used when the setting is missing; 0 means same as CFG_DEFAULT.
 * KFXCFG_DEPRECATED(NAME): deprecated.
 */
KFXCFG(INSTALL_PATH, "%PATH", "./", 0)
KFXCFG(LANGUAGE, "ENG|FRE|GER|ITA|SPA|SWE|POL|DUT|HUN|KOR|DAN|NOR|CZE|ARA|RUS|JPN|CHI|CHT|POR|HIN|BEN|JAV|LAT|UKR", "ENG", 0)
KFXCFG(FRONTEND_RES, "%WxHx32|DESKTOP|DESKTOP_FULL*3","640x480w32 DESKTOP DESKTOP", "320x200x8 640x480x8 640x480x8")
KFXCFG(INGAME_RES, "%WxHx32|DESKTOP|DESKTOP_FULL*~6", "DESKTOP DESKTOP_FULL 1920x1080x32", "320x200x8 640x480x8")
KFXCFG(DISPLAY_NUMBER, "1~","1",0)
KFXCFG(VSYNC,"ON|OFF","ON", 0)
KFXCFG(RENDERER, "SOFTWARE|OPENGL", "OPENGL", "SOFTWARE")
KFXCFG(VIEWPORT_MODE,"ORIGINAL|FULL|FULL_LETTERBOX","ORIGINAL", 0)
KFXCFG(RESIZE_MOVIES,"OFF|FIT|STRETCH|CROP|PIXELPERFECT|4BY3|4BY3PP|ON", "ON","OFF")
KFXCFG(FREEZE_GAME_ON_FOCUS_LOST,"ON|OFF","OFF",0)
KFXCFG(PAUSE_MUSIC_WHEN_GAME_PAUSED, "ON|OFF","OFF",0)
KFXCFG(MUTE_AUDIO_ON_FOCUS_LOST, "ON|OFF","OFF",0)
KFXCFG(ATMOSPHERIC_SOUNDS, "ON|OFF","OFF",0)
KFXCFG(ATMOS_VOLUME, "LOW|MEDIUM|HIGH", "MEDIUM", 0)
KFXCFG(ATMOS_FREQUENCY,"LOW|MEDIUM|HIGH", "MEDIUM", 0)
KFXCFG(ATMOS_SAMPLES,"1~*3","1014 1034 1013", 0)
KFXCFG(MUSIC_FROM_DISK,"ON|OFF","ON", 0)
KFXCFG(POINTER_SENSITIVITY,"0~10000", "0","100")
KFXCFG(CAPTURE_CURSOR, "ON|OFF","ON", 0)
KFXCFG(CURSOR_EDGE_CAMERA_PANNING, "ON|OFF","ON", 0)
KFXCFG(UNLOCK_CURSOR_WHEN_GAME_PAUSED, "ON|OFF","ON", "OFF")
KFXCFG(LOCK_CURSOR_IN_POSSESSION,"ON|OFF","ON", 0)
KFXCFG(RELATIVE_MOUSE_MODE,"ON|OFF","ON", 0)
KFXCFG(SCREENSHOT, "BMP|PNG", "PNG",0)
KFXCFG(DELTA_TIME, "ON|OFF","ON", 0)
KFXCFG(TURNS_PER_SECOND, "0~","20", 0)
KFXCFG(FRAMES_PER_SECOND,"%STRING", "0",0)
KFXCFG(MAX_ZOOM_DISTANCE,"0~100", "60", "100")
KFXCFG(PARCHMENT_MAP_FADE, "ON|OFF","OFF",0)
KFXCFG(CENSORSHIP, "ON|OFF","OFF",0)
KFXCFG(FLEE_BUTTON_DEFAULT,"ON|OFF","OFF",0)
KFXCFG(IMPRISON_BUTTON_DEFAULT,"ON|OFF","OFF",0)
KFXCFG(TAG_MODE_TOGGLING,"ON|OFF","OFF",0)
KFXCFG(DEFAULT_TAG_MODE, "SINGLE|DRAG|REMEMBER","SINGLE", 0)
KFXCFG(ZOOM_TO_MOUSE,"ON|OFF|WHEEL","WHEEL","OFF")
KFXCFG(ROTATE_AROUND_MOUSE,"ON|OFF|MOVEMENT_KEYS|ROTATION_KEYS","OFF",0)
KFXCFG(STARTUP,"LEGAL|FX|INTRO*~3", "LEGAL FX INTRO", 0)
KFXCFG(CREATURE_STATUS_SIZE, "0~32768", "16", 0)
KFXCFG(HAND_SIZE,"0~32767", "100",0)
KFXCFG(LINE_BOX_SIZE,"0~32768", "150",0)
KFXCFG(GUI_BLINK_RATE, "1~160", "1",0)
KFXCFG(NEUTRAL_FLASH_RATE, "1~160", "1",0)
KFXCFG(AUTOMATIC_REPLAYS,"ON|OFF","ON", 0)
KFXCFG(MAX_REPLAYS_CAMPAIGN, "0~","5",0)
KFXCFG(MAX_REPLAYS_FREEPLAY, "0~","5",0)
KFXCFG(MAX_REPLAYS_MULTIPLAYER,"0~","10", 0)
KFXCFG(REPLAY_MAX_SIZE,"0~","32768","0")
KFXCFG(API_ENABLED,"TRUE|FALSE","FALSE",0)
KFXCFG(API_PORT, "0~65535", "5599", 0)
KFXCFG(MATCHMAKING_SERVER, "%STRING", "matchmaking.keeperfx.workers.dev", 0)
KFXCFG(MULTIPLAYER_PORT, "1~65535", "5556", 0)
KFXCFG(EXIT_ON_LUA_ERROR,"TRUE|FALSE","FALSE",0)

KFXCFG_DEPRECATED(INSTALL_TYPE)
KFXCFG_DEPRECATED(KEYBOARD)
KFXCFG_DEPRECATED(SKIP_HEART_ZOOM)
KFXCFG_DEPRECATED(COMMAND_CHAR)
