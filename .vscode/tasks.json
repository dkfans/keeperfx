{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "debugChoice",
			"type": "pickString",
			"description": "Choose the debug option:",
			"options": [
				"DEBUG=1",
				"DEBUG=0",
				"FTEST_DEBUG=0",
				"FTEST_DEBUG=1"
			],
			"default": "DEBUG=1"
		}
	],
	"tasks": [
		{
			"label": "Configure build",
			"type": "shell",
			"windows": {
				"command": [
					"$compileSettingsFile = '{0}' -f '${workspaceFolder}\\.vscode\\compile_settings.cfg';",
					"$debugChoice = '${input:debugChoice}';",
					"$compileSettings = if (Test-Path $compileSettingsFile) { Get-Content $compileSettingsFile -Raw } else { \"DEBUG=1`nMAKE_JOBS=0`nHEAVYLOG=0`n\" };",
					"$currentChoice = [regex]::Match($compileSettings, '(?m)^(?:FTEST_)?DEBUG=[01]').Value;",
					"if ($currentChoice -ne $debugChoice) { $compileSettings = if ($currentChoice) { $compileSettings -replace '(?m)^(?:FTEST_)?DEBUG=[01]', $debugChoice } else { \"$debugChoice`n$compileSettings\" }; Set-Content -LiteralPath $compileSettingsFile -Value $compileSettings.TrimEnd(); if (Test-Path '${workspaceFolder}\\obj') { Remove-Item -LiteralPath '${workspaceFolder}\\obj' -Force -Recurse; } } else { Set-Content -LiteralPath $compileSettingsFile -Value $compileSettings.TrimEnd(); }",
				]
			},
			"linux": {
				"command": [
					"compileSettingsFile='${workspaceFolder}/.vscode/compile_settings.cfg';",
					"debugChoice='${input:debugChoice}';",
					"if [ ! -f \"$compileSettingsFile\" ]; then printf 'DEBUG=1\\nMAKE_JOBS=0\\nHEAVYLOG=0\\n' > \"$compileSettingsFile\"; fi;",
					"currentChoice=$(grep -m1 -E '^(FTEST_)?DEBUG=[01]' \"$compileSettingsFile\");",
					"if [ \"$currentChoice\" != \"$debugChoice\" ]; then if [ -n \"$currentChoice\" ]; then sed -i -E \"s/^(FTEST_)?DEBUG=[01]/$debugChoice/\" \"$compileSettingsFile\"; else printf '%s\\n' \"$debugChoice\" >> \"$compileSettingsFile\"; fi; make clean-build; fi"
				]
			},
			"problemMatcher": "$gcc",
			"group": {"kind": "build","isDefault": true},
			"presentation": {
				"clear": true,
				"echo": false,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false
			}
		},
		{
			// Called by launch.json
			"label": "Compile, Copy Files",
			"type": "shell",
			"windows": {
				"command": [
					"$script = '{0}' -f '${workspaceFolder}\\.vscode\\compile_and_copy_files.ps1';",
					"$compileSettingsFile = '{0}' -f '${workspaceFolder}\\.vscode\\compile_settings.cfg';",
					"powershell -ExecutionPolicy Bypass -File \\\"${script}\\\" -workspaceFolder \\\"${workspaceFolder}\\\" -compileSettingsFile \\\"${compileSettingsFile}\\\";",
				],
			},
			"linux": {
				"command": "bash '${workspaceFolder}/.vscode/compile_and_copy_files.sh' '${workspaceFolder}'"
			},
			"problemMatcher": "$gcc",
			"group": "build",
			"presentation": {
				"clear": true,
				"echo": false,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false
			}
		},
		{
			"label": "Log",
			"type": "shell",
			"windows": {
				"command": [
					"$gameDir = '${workspaceFolder}\\.vscode\\game';",
					"cd $gameDir;",
					"Clear-Content keeperfx.log;",
					"Get-Content keeperfx.log -Wait"
				]
			},
			"linux": {},
			"problemMatcher": "$gcc",
			"dependsOn": "Check For Game Directory",
			"group": "build"
		},
		{
			"label": "Clean",
			"type": "shell",
			"windows": {
				"command": "wsl make clean -j`nproc`"
			},
			"linux": {
				"command": "make clean -j`nproc`"
			},
			"problemMatcher": "$gcc",
			"group": "build"
		},
		{
			"label": "Generate compile_commands.json",
			"type": "shell",
			"windows": {
				"command": [
					"wsl make clean-build clean-tools;",
					"wsl bear -- make -j2 standard"
				]
			},
			"linux": {
				"command": "make clean-build clean-tools && bear -- make -j2 standard"
			},
			"problemMatcher": "$gcc",
			"group": "build",
			"dependsOn": "Compile",
		},
		{
			"label": "Deploy + Debug on Steam Deck",
			"type": "shell",
			"windows": {
				"command": "wsl bash ./scripts/deploy-to-deck.sh --gdb --binary out/keeperfx"
			},
			"linux": {
				"command": "bash ./scripts/deploy-to-deck.sh --gdb --binary out/keeperfx"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"clear": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"showReuseMessage": false
			}
		},
	],
}
