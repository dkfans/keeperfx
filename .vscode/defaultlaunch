// Please edit the "program" and "cwd" fields with your game directory.
// Edit "args" to set the level and campaign you want to load.
{
    "version": "0.2.0",
    "configurations": [
        {
            "program": "D:/DungeonKeeper/keeperfx.exe",
            "cwd": "D:/DungeonKeeper/",
            "args": [
                "-level", "00001",
                "-campaign", "keeporig",
                "-nointro","-alex"
            ],
            "windows": {
                "miDebuggerPath": "${workspaceFolder}/.vscode/gdb.exe"
                // "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
            },
            "linux": {
                "miDebuggerPath": "winegdb"
            },
            "setupCommands": [
                {"description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true},
                {"description": "Set Disassembly Flavor to Intel", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true}
            ],
            //"sourceFileMap": { "/mnt/d/": "D:/" }, // this is necessary so the debugger is able to find files when using breakpoints!
            "MIMode": "gdb",
            "name": "Compile, Copy Files, Launch keeperfx.exe",
            "preLaunchTask": "Compile, Copy Files",
            "type": "cppdbg",
            "request": "launch",
            "externalConsole": true,
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart",
            "logging": {
                "moduleLoad": false
            }
        },
        {
            // Native remote debug on a Steam Deck (or any Linux box) over gdbserver.
            // First deploy + start the server:  scripts/deploy-to-deck.sh --gdb
            // then launch this config to attach. See docs/steam-deck.md.
            "name": "Attach to Steam Deck (gdbserver)",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            // Local copy of the SAME binary you deployed - carries the symbols the
            // debugger reads. Point this at your build output (e.g. out/keeperfx).
            "program": "${workspaceFolder}/out/keeperfx",
            "miDebuggerServerAddress": "steamdeck:2345",
            "cwd": "${workspaceFolder}",
            // Map the on-Deck source path back to your working copy so breakpoints
            // resolve. Left side is where the binary was built; adjust if needed.
            "sourceFileMap": {
                "${workspaceFolder}": "${workspaceFolder}"
            },
            "windows": {
                "miDebuggerPath": "${workspaceFolder}/.vscode/gdb.exe"
            },
            "linux": {
                "miDebuggerPath": "gdb"
            },
            "setupCommands": [
                {"description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true},
                {"description": "Set Disassembly Flavor to Intel", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true}
            ],
            "externalConsole": false,
            "stopAtEntry": false
        }
    ]
}
