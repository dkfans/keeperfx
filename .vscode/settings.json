{
	"C_Cpp.intelliSenseEngine": "default",
	"cmake.configureOnOpen": false,
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Compile, Copy Files, Launch keeperfx.exe",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder}/.vscode/game/keeperfx.exe",
				"cwd": "${workspaceFolder}/.vscode/game",
				"args": [
					"-level", "00001",
					"-campaign", "keeporig",
					"-nointro", "-alex"
				],
				"MIMode": "gdb",
				"windows": {
					"miDebuggerPath": "${workspaceFolder}/.vscode/gdb.exe"
				},
				"linux": {
					"miDebuggerPath": "winegdb"
				},
				"preLaunchTask": "Compile, Copy Files",
				"externalConsole": true,
				"stopAtEntry": false,
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					},
					{
						"description": "Set Disassembly Flavor to Intel",
						"text": "-gdb-set disassembly-flavor intel",
						"ignoreFailures": true
					}
				]
			},
			{
				"name": "Attach to Steam Deck (gdbserver)",
				"type": "cppdbg",
				"request": "launch",
				"MIMode": "gdb",
				"program": "${workspaceFolder}/out/keeperfx",
				"miDebuggerServerAddress": "steamdeck:2345",
				"cwd": "${workspaceFolder}",
				"sourceFileMap": {
					"${workspaceFolder}": "${workspaceFolder}"
				},
				"windows": {
					"miDebuggerPath": "${workspaceFolder}/.vscode/gdb.exe"
				},
				"linux": {
					"miDebuggerPath": "gdb"
				},
				"externalConsole": false,
				"stopAtEntry": false
			}
		]
	},
	"search.exclude": {
		"**/.git": true,
		"**/.gitmodules": true,
		"**/.github": true,
		"**/deps": true,
		"**/obj": true,
		"**/sdl": true,
		"**/tests": true
	}
}
