#: guitext:202
msgctxt "Level name"
msgid "First step"
msgstr "Primer paso"

#: guitext:203
msgctxt "Level name"
msgid "Offspring"
msgstr "La descendencia"

#: guitext:204
msgctxt "Level name"
msgid "Snow white and dwarves"
msgstr "Blancanieves y los enanitos"

#: guitext:205
msgctxt "Level name"
msgid "Warlocks slave"
msgstr "Esclavo de los brujos"

#: guitext:206
msgctxt "Level name"
msgid "Ug the Barbarian"
msgstr "Ug el Bárbaro"

#: guitext:207
msgctxt "Level name"
msgid "Power of Faith"
msgstr "El poder de la fe"

#: guitext:208
msgctxt "Level name"
msgid "Indoctrination"
msgstr "Adoctrinamiento"

#: guitext:209
msgctxt "Level name"
msgid "Three on One"
msgstr "Tres contra uno"

#: guitext:210
msgctxt "Level name"
msgid "Impure Blood"
msgstr "Sangre impura"

#: guitext:211
msgctxt "Level name"
msgid "Save the Savior"
msgstr "Salva al salvador"

